# Template reference — the repo includes a ready-to-use `.env` with real values.
# Use this file only if `.env` is missing: npm run setup

# --- SMTP (required for contact / tour / admission form emails) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@forestviewmontessori.org
SMTP_PASS=
SMTP_FROM=info@forestviewmontessori.org
# Optional: office inbox for form notifications (defaults to SMTP_FROM)
# SMTP_TO=info@forestviewmontessori.org
# Set to 1 only for port 465 SSL
# SMTP_SECURE=0

# --- API server (optional for local dev) ---
# PORT=3000
# NODE_ENV=development

# --- Admin dashboard (/api/admin) — optional ---
# ADMIN_USERNAME=forestview
# ADMIN_PASSWORD=

# --- Production only ---
# API_ONLY=1
# DATA_DIR=/var/lib/forestview-submissions
