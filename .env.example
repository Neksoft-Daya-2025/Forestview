# Local environment template. Copy to `.env` and fill in private values.
# Do not commit `.env` or real credentials.

# --- SMTP (required in production for contact / tour / admission form emails) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: office inbox for form notifications (defaults to SMTP_FROM)
# SMTP_TO=
# Set to 1 only for port 465 SSL
# SMTP_SECURE=0

# --- API server ---
PORT=3000
NODE_ENV=development

# --- Admin dashboard (/api/admin) — required in production ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Production only ---
# API_ONLY=1
# DATA_DIR=/var/lib/forestview-submissions
