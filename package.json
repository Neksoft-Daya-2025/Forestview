{
  "name": "main-forestview",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup-env.js",
    "setup": "node scripts/setup-env.js",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "dev:api": "cross-env NODE_ENV=development node server/index.js",
    "dev:client": "vite",
    "dev": "cross-env NODE_ENV=development concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "test": "node --test test/*.test.js",
    "lint": "node scripts/lint-js.mjs",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "gsap": "^3.13.0",
    "lucide-react": "^1.16.0",
    "minimist": "^1.2.8",
    "nodemailer": "^9.0.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "playwright": "^1.52.0",
    "vite": "^8.0.13"
  }
}
